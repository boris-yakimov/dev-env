// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 20, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 1, // Gaps between modules (in pixels)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap"
        // "custom/media"
    ],
    "modules-center": [
        // "hyprland/window"
        "clock"
        // "tray" // allows other apps to display a status icon - like discord, steam, etc
    ],
    "modules-right": [
        "pulseaudio",
        "hyprland/language",
        // "bluetooth",
        "network",
        "custom/power"
        // "battery",
    ],
    // Modules configuration
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "tray": { // The tray module displays system tray icons in Waybar — these are background apps that advertise a status icon (like nm-applet, Bluetooth manager, Discord, Steam, Telegram, etc.)
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        "timezone": "Europe/Sofia",
        "format": "{:%a %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "format": {
                "months": "<span color='#7aa2f7'><b>{}</b></span>",      // light blue months
                "days": "<span color='#c0caf5'>{}</span>",               // soft lavender days
                "weeks": "<span color='#9ece6a'><b>W{}</b></span>",     // green week numbers
                "weekdays": "<span color='#bb9af7'><b>{}</b></span>",   // purple weekdays
                "today": "<span color='#f7768e'><b><u>{}</u></b></span>" // pink/red today
            }
        },
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-good": "", // An empty format will hide the module
        "format-full": "", // An empty format will hide the module
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": " ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)   \n{ifname} via {gwaddr} ",
        "format-ethernet": "󰈀",
        "tooltip-format-ethernet": "{ipaddr}/{cidr} 󰈀  \n{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ", // what to display when connection is active but no IP has been assigned yet, e.g. wire is connected but DHCP has not assigned an IP yet
        "format-disconnected": "Disconnected 󰤭",
        // "format-alt": "{ifname}: {ipaddr}/{cidr}", // (optional) what gets displayed on the bar when you click
        "on-click": "ghostty -e nmtui-connect" // (optional) what to open on click
    },
    "hyprland/language": {
      "format": "{}",
      "format-en": "en",
      "format-bg": "bg",
      "tooltip-format": "alt + shift"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "{volume}% ",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            // "default": ["", "", ""]
            "default": ["", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "youtube": "🎜", // TODO: update
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
        "format" : " ⏻ ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
          "shutdown": "shutdown",
          "reboot": "reboot",
          // "suspend": "systemctl suspend",
          // "hibernate": "systemctl hibernate"
        }
    }
}
